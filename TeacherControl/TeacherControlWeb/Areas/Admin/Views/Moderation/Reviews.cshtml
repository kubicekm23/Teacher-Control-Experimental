@model IEnumerable<TeacherControlWeb.Entities.ReviewEntity>
@{
    ViewData["Title"] = "Moderování recenzí";
}

<h1 class="mb-4">Moderování recenzí</h1>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Datum</th>
                    <th>Učitel</th>
                    <th>Autor</th>
                    <th>Hodnocení</th>
                    <th style="width: 40%;">Obsah</th>
                    <th class="text-end">Akce</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in Model)
                {
                    <tr>
                        <td class="small">@review.CreatedAt.ToString("g")</td>
                        <td>@review.Teacher?.FullName</td>
                        <td>
                            @review.User?.UserName
                            @if (review.IsAnonymous)
                            {
                                <span class="badge bg-secondary ms-1">Anonym</span>
                            }
                        </td>
                        <td>
                            <span class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </span>
                        </td>
                        <td class="small">@review.Content</td>
                        <td class="text-end">
                            <form asp-action="DeleteReview" asp-route-id="@review.Id" method="post" onsubmit="return confirm('Smazat tuto recenzi?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Smazat</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
