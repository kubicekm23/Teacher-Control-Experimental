@{
    ViewData["Title"] = "Domů";
}

<div class="text-center my-5">
    <h1 class="display-4">Vítejte v Teacher Control</h1>
    <p class="lead">Místo, kde studenti hodnotí své učitele a sdílejí své zážitky.</p>
</div>

<div class="row mt-5">
    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h3>Co je Teacher Control?</h3>
                <p>Teacher Control je experimentální platforma pro studenty, která umožňuje:</p>
                <ul>
                    <li><strong>Hodnotit učitele:</strong> Udělte hvězdičky a napište recenzi.</li>
                    <li><strong>Měřit dochvilnost:</strong> Sledujte pozdní příchody učitelů do hodin.</li>
                    <li><strong>Hlasovat v kategoriích:</strong> Kdo má nejlepší hlášky nebo je nejvíc sexy?</li>
                    <li><strong>Drbat:</strong> Živý chat pro školní memes a drby.</li>
                </ul>
                <div class="mt-4">
                    <a asp-controller="Teachers" asp-action="Index" class="btn btn-primary btn-lg me-2">Seznam učitelů</a>
                    <a asp-controller="Chat" asp-action="Index" class="btn btn-outline-primary btn-lg">Vstoupit do drbárny</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow border-warning mb-4">
            <div class="card-header bg-warning text-dark text-center py-3">
                <h4 class="mb-0"><i class="bi bi-crown-fill me-2"></i>Král/Královna dne</h4>
            </div>
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-person-circle display-1 text-muted"></i>
                </div>
                <h5>Zatím nikdo</h5>
                <p class="text-muted small">Staňte se prvním, kdo dnes získá Bingo a ovládne školu!</p>
                <button class="btn btn-warning w-100 mt-2" disabled>Hrát Bingo</button>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-lightning-fill me-2"></i>Poslední drby</h5>
            </div>
            <div class="card-body">
                <p class="text-muted italic text-center">Zatím je tu klid... možná až moc.</p>
                <a asp-controller="Chat" asp-action="Index" class="btn btn-sm btn-outline-danger w-100">Oživit to</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
