@model IEnumerable<TeacherControlWeb.Entities.ChatMessageEntity>

@{
    ViewData["Title"] = "Drbárna";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-chat-dots me-2"></i>Drbárna</h5>
        </div>
        <div class="card-body bg-light" id="chatWindow" style="height: 500px; overflow-y: auto;">
            @foreach (var msg in Model)
            {
                var isMine = msg.User?.UserName == User.Identity?.Name;
                <div class="mb-3 d-flex @(isMine ? "justify-content-end" : "justify-content-start")">
                    <div class="p-3 rounded shadow-sm @(isMine ? "bg-primary text-white" : "bg-white text-dark")" style="max-width: 70%;">
                        <div class="small fw-bold mb-1">@msg.User?.UserName</div>
                        @if (msg.Type == TeacherControlWeb.Entities.ChatMessageType.Meme)
                        {
                            <img src="@msg.Content" class="img-fluid rounded mb-2" alt="Meme" />
                        }
                        else
                        {
                            <div>@msg.Content</div>
                        }
                        <div class="text-end small opacity-75 mt-1">@msg.CreatedAt.ToString("HH:mm")</div>
                    </div>
                </div>
            }
        </div>
        <div class="card-footer">
            <form asp-action="Send" method="post" class="row g-2">
                <div class="col">
                    <input type="text" name="Content" class="form-control" placeholder="Napište zprávu..." required id="chatInput" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i></button>
                </div>
            </form>
            <div class="mt-2 small text-muted">
                Tip: Pro posílání memes vložte URL obrázku.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var chatWindow = document.getElementById("chatWindow");
            chatWindow.scrollTop = chatWindow.scrollHeight;
        });
    </script>
}
