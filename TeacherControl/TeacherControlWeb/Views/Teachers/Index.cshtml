@model IEnumerable<TeacherControlWeb.Entities.TeacherEntity>

@{
    ViewData["Title"] = "Seznam učitelů";
}

<h1 class="mb-4">Seznam učitelů</h1>

<div class="row">
    @foreach (var teacher in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@teacher.FullName</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@teacher.Subject</h6>
                    <p class="card-text text-truncate">@teacher.Description</p>
                    <div class="mb-3">
                        @{
                            var avgRating = teacher.Reviews.Any() ? teacher.Reviews.Average(r => r.Rating) : 0;
                        }
                        <div class="text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= avgRating ? "bi-star-fill" : (i - 0.5 <= avgRating ? "bi-star-half" : "bi-star"))"></i>
                            }
                            <span class="text-muted ms-2">(@teacher.Reviews.Count recenzí)</span>
                        </div>
                    </div>
                    <a asp-action="Details" asp-route-id="@teacher.Id" class="btn btn-primary">Zobrazit detail</a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
